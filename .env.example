# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable
# Solo servidor, NUNCA con NEXT_PUBLIC_. Activá "Places API (New)" y "Routes API" en Google Cloud.
# Sin esta clave el cotizador anda igual: los km se cargan a mano.
GOOGLE_MAPS_API_KEY=

# --- Fase 4: alertas automáticas (solo servidor) ---
# Clave de servicio de Supabase (Project Settings → API). Se salta RLS: jamás con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Secreto para la tarea programada: en Vercel, Vercel lo manda solo como "Authorization: Bearer ..."
CRON_SECRET=
# Mails con Resend (resend.com). Sin estas dos, las alertas se generan igual pero no se mandan por mail.
RESEND_API_KEY=
RESEND_FROM="FreteCerto <alertas@tu-dominio.com>"
# URL pública de la app, para el link del mail
APP_URL=https://tu-app.vercel.app
